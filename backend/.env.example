# MongoDB
MONGODB_URI=mongodb://localhost:27017/khelopatna

# Server
PORT=5001

# Auth (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin used in payment return URLs and shared links
FRONTEND_URL=http://localhost:3000

# Seed script passwords (optional; strong random passwords are generated and
# printed once if unset)
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_COUNSELLOR_PASSWORD=

# Payments — Cashfree (mock mode when unset in dev; REQUIRED in production —
# the server refuses to create/verify/refund payments without credentials)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=

# Email — Mailercloud (optional; logs to console when unset)
MAILERCLOUD_API_KEY=

# WhatsApp bot (optional)
WHATSAPP_ENABLED=false

# WhatsApp number that receives low-stock alerts (optional; alerts are skipped when unset)
LOW_STOCK_ALERT_PHONE=
