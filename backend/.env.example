# ═══════════════════════════════════════════════════════════════════
#  KheloPatna Backend — Environment Variables
#  Copy this file to .env and fill in real values before running.
# ═══════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string.
# Find it in: Supabase Dashboard → Settings → Database → URI (Connection Pooling)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Server ────────────────────────────────────────────────────────────────
PORT=5001

# ── Authentication ────────────────────────────────────────────────────────
# Use a long, random string (e.g. openssl rand -base64 64)
JWT_SECRET=change-me-to-a-long-random-string

# Seeding default Admin credentials on server boot (optional)
# Set these to seed/reset a SUPER_ADMIN staff user automatically.
# Leave blank to disable admin auto-seeding.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Frontend ──────────────────────────────────────────────────────────────
# Used in payment return URLs and shared booking links
FRONTEND_URL=http://localhost:3000

# ── Payments — Cashfree ───────────────────────────────────────────────────
# Required for live payments. In dev, mock mode is used when these are empty.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# sandbox | production
CASHFREE_WEBHOOK_SECRET=

# ── File Uploads — Cloudinary ─────────────────────────────────────────────
# Required to upload student photos & documents. Runs in MOCK mode when empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── WhatsApp Bot (optional) ───────────────────────────────────────────────
WHATSAPP_ENABLED=false
# Phone number that receives low-stock alerts (leave blank to disable)
LOW_STOCK_ALERT_PHONE=

# ── Email — Mailercloud (optional) ───────────────────────────────────────
# Logs to console when unset
MAILERCLOUD_API_KEY=

# ── Legacy Booking Sync (optional overrides) ──────────────────────────────
# Used by:  node sync_legacy_bookings.js   OR   npm run sync:legacy
# Defaults shown — override to change the sync window
# SYNC_FROM=2025-07-01
# SYNC_TO=2026-12-31
# DRY_RUN=false

# ── Groq AI Review Completion (optional) ─────────────────────────────────
# Required for generating dynamic Google reviews. Runs in offline fallback mode when empty.
GROQ_API_KEY=

